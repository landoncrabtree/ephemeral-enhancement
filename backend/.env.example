# Shared join token(s). Comma-separated to allow several.
# Give this to anyone who should be able to submit runs:
#   python run_pipeline.py --join-network <token>
EE_TOKEN=change-me-to-a-long-random-string

# Where the SQLite database lives (optional)
# EE_DB_PATH=runs.db

# Repo polled for the "new version available" banner (public, no auth needed)
EE_GITHUB_REPO=landoncrabtree/ephemeral-enhancement
EE_GITHUB_BRANCH=main
